rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/students/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/students/$(request.auth.uid)).data.isAdmin == true;
    }

    function isVerifiedOrg() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/organizations/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/organizations/$(request.auth.uid)).data.verified == true;
    }

    // Admin-posted opportunities have no orgId field at all — treat that as ''
    // so applying to them still works.
    function opportunityOrgId(oppId) {
      let opp = get(/databases/$(database)/documents/opportunities/$(oppId)).data;
      return ('orgId' in opp) ? opp.orgId : '';
    }

    // A student can read any profile (for future features) but only write their own
    match /students/{studentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == studentId;
    }

    // An org can create its own profile (always starting unverified/pending) and
    // read it back. Only the org owner or an admin can update it, and only an
    // admin can flip verified/status — the org itself can edit everything else
    // (name, contact info, etc.) but not approve itself.
    match /organizations/{orgId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == orgId &&
        request.resource.data.verified == false &&
        request.resource.data.status == 'pending';
      allow update: if isAdmin() ||
        (request.auth != null && request.auth.uid == orgId &&
         request.resource.data.verified == resource.data.verified &&
         request.resource.data.status == resource.data.status);
    }

    // Anyone signed in can read opportunities. Admins can write any of them.
    // Verified orgs can create their own (orgId must be their own uid) and can
    // only update/delete listings they own.
    match /opportunities/{opportunityId} {
      allow read: if request.auth != null;
      allow create: if isAdmin() ||
        (isVerifiedOrg() && request.resource.data.orgId == request.auth.uid);
      allow update, delete: if isAdmin() ||
        (isVerifiedOrg() && resource.data.orgId == request.auth.uid);
    }

    // A student can create/read/update their own applications. The orgId on an
    // application must match the actual owning org of that opportunity (checked
    // against the opportunity doc, not just trusted from the client) so a student
    // can't misdirect an application to the wrong org. The owning org can read
    // and update (e.g. mark shortlisted/rejected) applications to their own
    // listings, but can't touch studentId/opportunityId/orgId.
    match /applications/{applicationId} {
      allow create: if request.auth != null &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.orgId == opportunityOrgId(request.resource.data.opportunityId);

      allow read: if request.auth != null &&
        (resource.data.studentId == request.auth.uid ||
         resource.data.orgId == request.auth.uid ||
         isAdmin());

      allow update: if request.auth != null &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.opportunityId == resource.data.opportunityId &&
        request.resource.data.orgId == resource.data.orgId &&
        (resource.data.studentId == request.auth.uid ||
         resource.data.orgId == request.auth.uid ||
         isAdmin());
    }
  }
}
